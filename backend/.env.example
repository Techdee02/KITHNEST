# Local dev: plain Postgres in Docker (see docker-compose.yml).
# Going live later: replace with the Supabase project's Postgres connection
# string — same schema, same code, no application changes needed.
DATABASE_URL=postgresql+asyncpg://kithnest:kithnest@localhost:5433/kithnest

# Used to sign/verify session JWTs. Generate a real random value for anything
# beyond local dev, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-only-secret-change-me

# Origin the frontend is served from, for CORS.
FRONTEND_ORIGIN=http://localhost:5173

# Where uploaded logos are saved locally. Swapped for Supabase Storage later
# behind the StorageBackend interface in app/storage.py.
UPLOAD_DIR=uploads
