# Local dev: plain Postgres in Docker (see docker-compose.yml).
# Going live: point this at Supabase's connection-pooler string instead
# (Project Settings → Database → Connection Pooling, port 6543), with the
# scheme changed to postgresql+asyncpg:// — same schema, same code.
DATABASE_URL=postgresql+asyncpg://kithnest:kithnest@localhost:5433/kithnest

# Used to sign/verify session JWTs. Generate a real random value for anything
# beyond local dev, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-only-secret-change-me

# Origin the frontend is served from, for CORS.
FRONTEND_ORIGIN=http://localhost:5173

# Where uploaded logos are saved when SUPABASE_URL below is unset (local dev).
UPLOAD_DIR=uploads

# Leave both unset for local dev — logo uploads fall back to local disk.
# Set both once you have a real Supabase project to switch to Supabase
# Storage automatically (see app/storage.py) — no code change needed.
# The bucket (default "school-logos") must already exist and be public.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=school-logos
