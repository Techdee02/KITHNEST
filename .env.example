# Base URL of the Kithnest backend API. Defaults to the relative "/api",
# which goes through the Vite dev proxy (see vite.config.ts) straight to the
# backend inside the container — this works whether you're on localhost or a
# forwarded Codespace URL, so you normally don't need to set this at all.
# Only override it if the backend is running somewhere else entirely.
# VITE_API_BASE_URL=http://localhost:8000/api
